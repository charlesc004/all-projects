{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sentinelml.example/events/fraud.alert.created.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "const": "fraud.alert.created.v1"
    },
    "schema_version": {
      "const": 1
    },
    "organization_id": {
      "type": "string",
      "format": "uuid"
    },
    "transaction_id": {
      "type": "string",
      "format": "uuid"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "properties": {
        "alert_id": {
          "type": "string",
          "format": "uuid"
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        }
      },
      "required": [
        "alert_id",
        "severity"
      ],
      "additionalProperties": false
    },
    "trace_parent": {
      "type": "string",
      "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"
    }
  },
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "organization_id",
    "transaction_id",
    "correlation_id",
    "occurred_at",
    "payload"
  ]
}
