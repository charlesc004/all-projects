generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  SALES_REP
}
enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
}
enum LeadSource {
  WEBSITE
  REFERRAL
  LINKEDIN
  OUTBOUND
  EVENT
  OTHER
}
enum Priority {
  LOW
  MEDIUM
  HIGH
}
enum DealStage {
  QUALIFICATION
  DISCOVERY
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}
enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

model Organization {
  id            String   @id @default(cuid())
  name          String
  website       String?
  industry      String?
  address       String?
  currency      String   @default("USD")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  users         User[]
  companies     Company[]
  leads         Lead[]
  contacts      Contact[]
  deals         Deal[]
  tasks         Task[]
  notes         Note[]
  activities    Activity[]
  notifications Notification[]
}

// A user's required organizationId and role are the membership equivalent.
// Every relation is also checked against organizationId at the service boundary.
model User {
  id             String @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  email          String @unique
  name           String
  passwordHash   String
  role           Role @default(SALES_REP)
  active         Boolean @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  leads          Lead[]
  contacts       Contact[]
  companies      Company[]
  deals          Deal[]
  tasks          Task[]
  notes          Note[]
  activities     Activity[]
  notifications  Notification[]
  refreshTokens  RefreshToken[]
  @@unique([id, organizationId])
  @@index([organizationId, role])
}

model Company {
  id             String @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String
  website        String?
  industry       String?
  size           String?
  phone          String?
  address        String?
  ownerId        String
  owner          User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  archivedAt     DateTime?
  contacts       Contact[]
  deals          Deal[]
  convertedLeads Lead[]
  tasks          Task[]
  notes          Note[]
  activities     Activity[]
  @@unique([id, organizationId])
  @@index([organizationId, archivedAt, name])
}

model Lead {
  id             String @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  firstName      String
  lastName       String
  email          String?
  phone          String?
  companyName    String?
  title          String?
  source         LeadSource @default(WEBSITE)
  status         LeadStatus @default(NEW)
  priority       Priority @default(MEDIUM)
  ownerId        String
  owner          User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  convertedAt    DateTime?
  convertedContactId String?
  convertedContact Contact? @relation(fields: [convertedContactId], references: [id], onDelete: SetNull)
  convertedCompanyId String?
  convertedCompany Company? @relation(fields: [convertedCompanyId], references: [id], onDelete: SetNull)
  convertedDealId String? @unique
  convertedDeal Deal? @relation(fields: [convertedDealId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  archivedAt     DateTime?
  tasks          Task[]
  notes          Note[]
  activities     Activity[]
  @@unique([id, organizationId])
  @@index([organizationId, archivedAt, status, createdAt])
  @@index([organizationId, ownerId])
}

model Contact {
  id             String @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  firstName      String
  lastName       String
  email          String?
  phone          String?
  jobTitle       String?
  companyId      String?
  company        Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  ownerId        String
  owner          User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  archivedAt     DateTime?
  convertedLeads Lead[]
  deals          Deal[]
  tasks          Task[]
  notes          Note[]
  activities     Activity[]
  @@unique([id, organizationId])
  @@index([organizationId, archivedAt, lastName])
  @@index([organizationId, email])
}

model Deal {
  id             String @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  title          String
  value          Decimal @db.Decimal(14, 2)
  stage          DealStage @default(QUALIFICATION)
  expectedCloseDate DateTime?
  closedAt       DateTime?
  lostReason     String?
  ownerId        String
  owner          User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  companyId      String?
  company        Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId      String?
  contact        Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  archivedAt     DateTime?
  convertedLead  Lead?
  tasks          Task[]
  notes          Note[]
  activities     Activity[]
  @@unique([id, organizationId])
  @@index([organizationId, archivedAt, stage])
  @@index([organizationId, closedAt])
}

model Task {
  id             String @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  title          String
  description    String?
  dueDate        DateTime?
  priority       Priority @default(MEDIUM)
  status         TaskStatus @default(TODO)
  completedAt    DateTime?
  assigneeId     String
  assignee       User @relation(fields: [assigneeId], references: [id], onDelete: Restrict)
  leadId         String?
  lead           Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contactId      String?
  contact        Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  companyId      String?
  company        Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  dealId         String?
  deal           Deal? @relation(fields: [dealId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  notes          Note[]
  activities     Activity[]
  @@unique([id, organizationId])
  @@index([organizationId, assigneeId, status, dueDate])
}

model Note {
  id             String @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  authorId       String
  author         User @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body           String
  leadId         String?
  lead           Lead? @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contactId      String?
  contact        Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  companyId      String?
  company        Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  dealId         String?
  deal           Deal? @relation(fields: [dealId], references: [id], onDelete: Cascade)
  taskId         String?
  task           Task? @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([organizationId, createdAt])
  @@index([leadId])
  @@index([contactId])
  @@index([companyId])
  @@index([dealId])
}

model Activity {
  id             String @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actorId        String
  actor          User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  type           String
  title          String
  description    String?
  leadId         String?
  lead           Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contactId      String?
  contact        Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  companyId      String?
  company        Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  dealId         String?
  deal           Deal? @relation(fields: [dealId], references: [id], onDelete: SetNull)
  taskId         String?
  task           Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  @@index([organizationId, createdAt])
  @@index([leadId])
  @@index([contactId])
  @@index([companyId])
  @@index([dealId])
}

model Notification {
  id             String @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userId         String
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  body           String
  href           String?
  readAt         DateTime?
  dedupeKey      String? @unique
  createdAt      DateTime @default(now())
  @@index([organizationId, userId, readAt, createdAt])
}

model RefreshToken {
  id             String @id @default(cuid())
  tokenHash      String @unique
  familyId       String
  userId         String
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime @default(now())
  @@index([userId, familyId])
}
