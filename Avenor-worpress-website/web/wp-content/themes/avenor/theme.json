{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "800px",
      "wideSize": "1328px"
    },
    "useRootPaddingAwareAlignments": true,
    "color": {
      "defaultPalette": false,
      "palette": [
        {
          "slug": "ink",
          "color": "#F2F1EA",
          "name": "Ink"
        },
        {
          "slug": "muted",
          "color": "#A3A5A9",
          "name": "Muted"
        },
        {
          "slug": "paper",
          "color": "#101113",
          "name": "Paper"
        },
        {
          "slug": "white",
          "color": "#1D1F23",
          "name": "Surface"
        },
        {
          "slug": "accent",
          "color": "#D2F65A",
          "name": "Accent"
        },
        {
          "slug": "line",
          "color": "#34363A",
          "name": "Line"
        },
        {
          "slug": "soft",
          "color": "#17191C",
          "name": "Soft"
        },
        {
          "slug": "deep",
          "name": "Deep",
          "color": "#090A0B"
        },
        {
          "slug": "copper",
          "name": "Copper",
          "color": "#C1B3FA"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "sans",
          "name": "Grotesk",
          "fontFamily": "Arial, Helvetica, sans-serif"
        },
        {
          "slug": "serif",
          "name": "Display grotesk",
          "fontFamily": "Arial, Helvetica, sans-serif"
        },
        {
          "slug": "mono",
          "name": "Technical mono",
          "fontFamily": "\"Courier New\", monospace"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "size": "13px",
          "name": "Small"
        },
        {
          "slug": "medium",
          "size": "16px",
          "name": "Body"
        },
        {
          "slug": "large",
          "size": "28px",
          "name": "Large"
        },
        {
          "slug": "x-large",
          "size": "56px",
          "name": "Editorial"
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "vw",
        "%"
      ],
      "spacingSizes": [
        {
          "slug": "small",
          "size": "20px",
          "name": "Small"
        },
        {
          "slug": "medium",
          "size": "40px",
          "name": "Medium"
        },
        {
          "slug": "large",
          "size": "80px",
          "name": "Large"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|paper",
      "text": "var:preset|color|ink"
    },
    "spacing": {
      "blockGap": "24px"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|sans",
      "fontSize": "16px",
      "lineHeight": "1.65"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|sans",
          "fontWeight": "600",
          "lineHeight": "1.02"
        }
      },
      "button": {
        "border": {
          "radius": "0"
        },
        "color": {
          "background": "var:preset|color|accent",
          "text": "var:preset|color|paper"
        },
        "spacing": {
          "padding": {
            "top": "16px",
            "bottom": "16px",
            "left": "26px",
            "right": "26px"
          }
        },
        "typography": {
          "fontFamily": "var:preset|font-family|sans",
          "fontSize": "13px",
          "fontWeight": "600"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ]
}
