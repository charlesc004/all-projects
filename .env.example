# Local development only. Run npm run setup:env to generate unique signing secrets.
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://nexus:nexus_local_only@127.0.0.1:5432/nexus?schema=public
# Optional distributed login rate limiting. In development an in-process limiter is used
# when Redis cannot be reached. See README for the production requirement.
REDIS_URL=redis://127.0.0.1:6379
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
POSTGRES_PASSWORD=nexus_local_only
SEED_REFERENCE_DATE=2026-10-18
# Test database must use a dedicated database/schema; never point this at production.
DATABASE_URL_TEST=postgresql://nexus:nexus_local_only@127.0.0.1:5432/nexus_test?schema=public
